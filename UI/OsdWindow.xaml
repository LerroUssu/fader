<Window x:Class="Otto.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otto OSD" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="Root" Margin="14">
        <Border CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="14,10,16,10" MinWidth="250">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Rectangle x:Name="IconRect" RadiusX="7" RadiusY="7">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="IconBrush" Stretch="Uniform"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock x:Name="GlyphText" Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyText}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="220" Text="App"/>
                    <Grid Height="4" Margin="0,7,0,0" Width="170" HorizontalAlignment="Left">
                        <Border Background="{StaticResource TrackBrush}" CornerRadius="2"/>
                        <Border x:Name="Fill" Background="{DynamicResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Width="85"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="ValueText" Grid.Column="2" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" Text="50"/>
            </Grid>
        </Border>
    </Grid>
</Window>
